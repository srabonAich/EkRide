# =====================================================================
# EkRide Environment Configuration Template
# =====================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# =====================================================================

# Server & Network Ports
SERVER_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL Configuration
# If running with Docker Compose: docker compose up -d
DB_HOST=localhost
DB_PORT=5434
DB_NAME=map_db
DB_USER=postgres
DB_PASSWORD=postgres

# Google Maps Platform Configuration (Optional)
# If left empty, EkRide automatically falls back to OSRM real-road routing and demo places!
# You can provide your key here OR in an Api-key.txt file in the project root.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_FILE=Api-key.txt
DEMO_MODE_FALLBACK=true

# Security (JWT)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Matching & Corridor Constraints
MAX_SEARCH_RADIUS_METERS=3000.0
MAX_DETOUR_METERS=4000.0
MAX_DETOUR_MINUTES=15.0

# Fare Policy (BDT)
BASE_FARE=50.00
PER_KM_RATE=25.00
PER_MINUTE_RATE=0.00
MINIMUM_FARE=60.00
PLATFORM_FEE_PERCENT=10.00
